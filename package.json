{
  "name": "pensieve-dashboard-plugin",
  "version": "0.1.0",
  "description": "A local dashboard plugin for structured LLM memory visibility and lightweight governance.",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "next lint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --experimental-test-isolation=none ./lib/*.test.ts ./lib/providers/*.test.ts ./lib/hosts/*.test.ts",
    "package:plugin": "node ./scripts/package-codex-plugin.mjs",
    "test:package": "node --test --experimental-test-isolation=none ./scripts/package-codex-plugin.test.mjs",
    "ci:check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "next": "15.5.25",
    "openai": "^5.23.2",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
